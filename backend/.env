# CrowdCampaign backend settings. This file is committed ON PURPOSE:
# the course asks for a working .env pointing at a THROWAWAY database.
#
# Only two kinds of values belong here:
#   1. the throwaway Neon database URL made for this assignment
#   2. settings that are not secret
# Personal keys (AI API keys) go in backend/.env.local, which git ignores.

# Neon dashboard -> your project -> Connect -> copy the connection string.
DATABASE_URL=postgresql://REPLACE_WITH_YOUR_NEON_CONNECTION_STRING

PORT=4000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
TOKEN_TTL_SECONDS=7200
AI_PROVIDER=auto
